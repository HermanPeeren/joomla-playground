{
  "name": "joomla-playground",
  "private": true,
  "description": "Joomla running in the browser via PHP-in-WebAssembly, comparable to WordPress Playground",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "docs:pdf": "node scripts/build-docs.mjs",
    "wasm:serve": "node wasm/serve.mjs",
    "wasm:cli": "node wasm/cli.mjs",
    "bundle": "php bin/build-browser-bundles.php",
    "web:dev": "vite --config web/vite.config.js",
    "web:build": "vite build --config web/vite.config.js",
    "web:preview": "vite preview --config web/vite.config.js --port 5401",
    "test:browser": "node --test --test-timeout=600000 tests/browser/playground.test.mjs",
    "test:proxy": "node --test tests/proxy/cors-proxy.test.mjs",
    "proxy:dev": "node proxy/dev-server.mjs"
  },
  "devDependencies": {
    "@php-wasm/fs-journal": "3.1.60",
    "@php-wasm/node": "3.1.60",
    "@php-wasm/util": "3.1.60",
    "@php-wasm/universal": "3.1.60",
    "@php-wasm/web": "3.1.60",
    "marked": "18.1.1",
    "playwright-core": "1.64.1",
    "vite": "6.4.5"
  }
}
