{
  "meta": {
    "title": "Multilingual demo: UNESCO World Heritage",
    "description": "A Joomla site in English, Dutch, German, French and Spanish, with the heritage dataset of Clifford E Ford's demonstration data plugin.",
    "author": "Joomla Playground",
    "prebuild": true
  },
  "preferredVersions": {
    "joomla": "6.2"
  },
  "landingPage": "/index.php",
  "steps": [
    {
      "step": "installLanguage",
      "language": "nl-NL"
    },
    {
      "step": "installLanguage",
      "language": "de-DE"
    },
    {
      "step": "installLanguage",
      "language": "fr-FR"
    },
    {
      "step": "installLanguage",
      "language": "es-ES"
    },
    {
      "step": "enableExtension",
      "element": "languagefilter",
      "type": "plugin",
      "folder": "system"
    },
    {
      "step": "addModule",
      "module": "mod_languages",
      "title": "Languages",
      "position": "topbar",
      "showtitle": false,
      "params": {
        "dropdown": "0",
        "image": "1",
        "inline": "1",
        "full_name": "0",
        "show_active": "1"
      }
    },
    {
      "step": "installExtension",
      "url": "assets/cefjdemos/mod_demodata.zip"
    },
    {
      "step": "addModule",
      "module": "mod_demodata",
      "title": "Demonstration Data",
      "position": "cpanel",
      "client": "administrator"
    },
    {
      "step": "installExtension",
      "url": "assets/cefjdemos/plg_demodata_features101.zip"
    },
    {
      "step": "enableExtension",
      "element": "features101",
      "type": "plugin",
      "folder": "demodata",
      "params": {
        "dataset": "heritage",
        "languages": "en-GB,nl-NL,de-DE,fr-FR,es-ES"
      }
    },
    {
      "step": "addUserGroup",
      "title": "Magazine Reviewers",
      "parent": "Registered"
    },
    {
      "step": "disableExtension",
      "element": "finder",
      "type": "plugin",
      "folder": "content"
    },
    {
      "step": "importSampleData",
      "group": "demodata",
      "type": "features101",
      "query": {
        "action": "install"
      }
    },
    {
      "step": "enableExtension",
      "element": "finder",
      "type": "plugin",
      "folder": "content"
    },
    {
      "step": "enableExtension",
      "element": "com_finder",
      "type": "component",
      "params": {
        "batch_size": "5"
      }
    },
    {
      "step": "indexSmartSearch",
      "background": true
    }
  ]
}
