{
    "name": "joomla-projects/joomla-playground",
    "description": "Joomla running in the browser via PHP-in-WebAssembly, comparable to WordPress Playground",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "wordpress/mysql-on-sqlite",
                "version": "3.1.1",
                "license": "GPL-2.0-or-later",
                "autoload": {
                    "files": [
                        "packages/mysql-on-sqlite/src/load.php"
                    ]
                },
                "source": {
                    "url": "https://github.com/WordPress/sqlite-database-integration.git",
                    "type": "git",
                    "reference": "v3.1.1"
                }
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-pdo_sqlite": "*",
        "cweagans/composer-patches": "^2.0",
        "wordpress/mysql-on-sqlite": "3.1.1"
    },
    "require-dev": {
        "joomla/database": "4.0.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "JoomlaPlayground\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JoomlaPlayground\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "cweagans/composer-patches": true
        }
    },
    "extra": {
        "patches": {
            "wordpress/mysql-on-sqlite": [
                {
                    "description": "Translate GROUP_CONCAT() with SEPARATOR, ORDER BY and several expressions (until it is in a release; see patches/README.md)",
                    "url": "patches/mysql-on-sqlite-group-concat.patch"
                }
            ]
        }
    }
}
